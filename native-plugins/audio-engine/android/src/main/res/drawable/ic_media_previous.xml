<?xml version="1.0" encoding="utf-8"?>
<!-- Notification action icon: Previous. Plain alpha-only glyph (single
     fill, no gradients) so it tints correctly on the media notification's
     action row — the old android.R.drawable.ic_media_previous framework
     icon this replaces is a pre-Material relic that renders blank/invisible
     on many modern devices and OEM skins, which is what made the
     notification fall back to showing text ("Previous"/"Pause"/"Next")
     instead of the compact icon-only Spotify/Apple-Music-style row. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">
    <path
        android:fillColor="#FF000000"
        android:pathData="M6,6h2v12H6zM9.5,12l8.5,6V6z" />
</vector>
