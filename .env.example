# Client-side only — never put a secret in a VITE_ variable, it ships in the built JS.
# Plus screen + plan cards (default: on). Set to false to hide.
VITE_MONETIZATION_ENABLED=true
VITE_SUBSCRIPTIONS_ENABLED=true
# Native builds only (browsers are always treated as "web"): play_store (default) | sideload
#   TESTING payments: VITE_DISTRIBUTION=web (or sideload) + VITE_RAZORPAY_ENABLED=true
VITE_DISTRIBUTION=play_store
VITE_RAZORPAY_ENABLED=true

# --- Supabase Edge Function secrets (set with `supabase secrets set`, NOT here) ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# BILLING_ACCOUNT_HMAC_SECRET=
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# --- Ads (AdMob). No domain needed. Off unless VITE_ADS_ENABLED=true. ---
# Free plan only; never in chat/calls/login/linking (src/lib/monetization/adPolicy.ts).
# Leave the unit id unset while testing: the plugin uses Google's TEST banner.
# VITE_ADS_ENABLED=false
# VITE_ADMOB_BANNER_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# In-app (OTA) updates. Set to "true" to compile the self-updater out of a build
# (use it for Google Play uploads: Play forbids an app updating itself, and the
# updater already switches itself off when it detects a Play install).
# VITE_DISABLE_SELF_UPDATE=true

# --- Cloudinary media (new photos/videos; legacy Supabase Storage media keeps working) ---
# Client-safe: the public cloud name only. Its presence switches Gallery/Memories/avatars to
# Cloudinary for NEW uploads. Leave unset to keep everything on Supabase Storage.
# VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
# VITE_CLOUDINARY_API_KEY is NOT needed by the client (the signing function returns it per upload).
# Chat media is OFF unless you opt in (apply migration 20261004100000 first):
# VITE_CLOUDINARY_CHAT_MEDIA_ENABLED=false
# VITE_CLOUDINARY_MEDIA_ENABLED=true   # set false to force Gallery/Memories back to Supabase Storage
#
# Server-side ONLY (supabase secrets set ...). NEVER put these in a VITE_ variable:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Optional limits (defaults: image 20 MB, video 100 MB, 600 s, 12000 px):
# MEDIA_MAX_IMAGE_BYTES=
# MEDIA_MAX_VIDEO_BYTES=
# MEDIA_MAX_VIDEO_SECONDS=
