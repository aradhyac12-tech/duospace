# Self-hosted calling — PRODUCTION environment (placeholders only).
# Use:  docker compose --env-file .env.production up      (from infrastructure/deployment)
# Never commit a filled-in copy of this file.
#
# MEDIA/SFU/TURN RUN ON LIVEKIT CLOUD (Build plan, free tier) — this
# compose file only runs the signaling gateway (call-control: ring/accept/
# reject/cancel/end). There is no local LiveKit or coturn container, no
# VPS-hosted TURN, and no TLS cert to manage for media — LiveKit Cloud
# terminates TLS and provides TURN itself. Get your Cloud project's
# wss:// URL + API key/secret from https://cloud.livekit.io (Settings →
# Keys) and set them as SUPABASE SECRETS ONLY — see
# infrastructure/deployment/README.md step 2. They are consumed exclusively
# by the `livekit-token` edge function, never by anything in this compose
# stack, so they do NOT belong in this file. Use a dedicated production
# key pair — never reuse local/staging values.

# --- infrastructure/signaling (the Call Gateway) --------------------------
SIGNALING_PORT=8787
# Same JWT secret your Supabase project signs access tokens with.
# Shared HS256 secret for signaling tickets. Set the SAME value as the
# Supabase Edge Function secret SIGNALING_TICKET_SECRET (generate: openssl rand -hex 32).
# (Not SUPABASE_JWT_SECRET: Supabase reserves the SUPABASE_ prefix and does not
# inject the JWT secret into Edge Functions.)
SIGNALING_TICKET_SECRET=
# PHASE 4 — REQUIRED. The gateway authorizes every call-control message
# against Supabase through ONE service-role-only RPC
# (signaling_get_call_facts, migration 20260920140000/20260921065718).
# SERVER-SIDE ONLY: never a VITE_ variable, never committed.
SUPABASE_URL=https://REPLACE_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Origin allowlist for the WebSocket upgrade (comma-separated). Empty = no
# check — acceptable ONLY for local development.
SIGNALING_ALLOWED_ORIGINS=https://REPLACE.example.com,https://localhost,capacitor://localhost
SIGNALING_RING_TTL_MS=40000

# --- frontend (Vite — build-time, PUBLIC by definition) --------------------
# Never put SUPABASE_SERVICE_ROLE_KEY or any LiveKit Cloud secret behind a
# VITE_ prefix — it would be bundled into the client. REQUIRED: the
# self-hosted signaling stack is the only calling provider, there is no
# provider switch and no fallback. If unset the app refuses to place or
# accept calls (clear NOT_CONFIGURED error) — it never falls back to
# Supabase Realtime or any other provider.
VITE_SIGNALING_URL=wss://signaling.REPLACE.example.com
# Also set as a Supabase secret (runtime URL for builds made without VITE_SIGNALING_URL):
SIGNALING_PUBLIC_URL=wss://signaling.REPLACE.example.com
