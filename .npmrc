# Vercel/CI sometimes sets NODE_ENV=production, which makes npm skip
# devDependencies — that is what produced "vite: command not found"
# (exit 127) on Vercel. vite, typescript and the vite plugins all live in
# devDependencies, so they must always be installed for a build.
# `include=dev` is the supported npm 8+ way to force that (the old
# `production=false` / empty `omit=` lines only produced config warnings).
include=dev
registry=https://registry.npmjs.org/
