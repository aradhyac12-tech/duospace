# Copy this file to .env.local for local development, or configure the same
# variables as Cloudflare Pages build environment variables for production.
#
# Supabase project: jzlpelxwzjjpddqcrtpu
# Get the publishable/anon key from: Supabase Dashboard → Project Settings → API
#
# Only the publishable/anon key belongs here. Never put a service-role key
# or any other backend secret in a VITE_-prefixed variable — anything with
# that prefix is bundled into the client-side JavaScript and is public.

VITE_SUPABASE_URL=https://jzlpelxwzjjpddqcrtpu.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key

# Optional. Only needed to pin the OAuth/email redirect origin explicitly
# (e.g. a custom domain). If unset, the app safely falls back to the
# browser's own origin at runtime — most deployments can leave this unset.
# VITE_PUBLIC_SITE_URL=https://your-production-domain.com
